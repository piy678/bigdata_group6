


import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns


spotify_df = pd.read_csv("D:/BigDataEng/Projekt/data/processed/spotify_cleaned.csv")
top100_df = pd.read_csv("D:/BigDataEng/Projekt/data/processed/top100_cleaned.csv")
api_df = pd.read_csv("D:/BigDataEng/Projekt/data/processed/api_cleaned.csv")
web_df = pd.read_csv("D:/BigDataEng/Projekt/data/processed/webscraping_cleaned.csv")


spotify_df['release_year'] = pd.to_datetime(spotify_df['release_date'], errors='coerce').dt.year
top100_df['release_year'] = pd.to_datetime(top100_df['release_date'], errors='coerce').dt.year






sns.set(style="whitegrid")
plt.figure(figsize=(10,5))
sns.lineplot(data=spotify_df.groupby('release_year')['popularity'].mean().reset_index(),
             x='release_year', y='popularity', marker="o")
plt.title("Durchschnittliche Spotify-Popularität pro Jahr")
plt.xlabel("Jahr")
plt.ylabel("Durchschnittliche Popularität")
plt.tight_layout()
plt.show()









top_genres = top100_df.groupby('top genre')['popularity'].mean().sort_values(ascending=False).head(10).reset_index()
plt.figure(figsize=(10,5))
sns.barplot(data=top_genres, x='popularity', y='top genre', palette="viridis")
plt.title("Top 10 Musikgenres nach Beliebtheit (Top100)")
plt.xlabel("Durchschnittliche Popularität")
plt.ylabel("Genre")
plt.tight_layout()
plt.show()










genre_year = top100_df.groupby(['release_year', 'top genre'])['popularity'].mean().reset_index()


top_genres = genre_year['top genre'].value_counts().head(5).index.tolist()
filtered = genre_year[genre_year['top genre'].isin(top_genres)]

plt.figure(figsize=(10,6))
sns.lineplot(data=filtered, x='release_year', y='popularity', hue='top genre')
plt.title("Beliebtheit von Top-Genres über die Jahre")
plt.xlabel("Jahr")
plt.ylabel("Durchschnittliche Popularität")
plt.tight_layout()
plt.show()









