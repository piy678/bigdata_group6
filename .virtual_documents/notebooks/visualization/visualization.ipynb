import pandas as pd
import plotly.graph_objects as go

spotify_df['release_date'] = spotify_df['release_date'].astype(str).apply(
    lambda x: x + '-01-01' if len(x) == 4 else x
)
spotify_df['release_year'] = pd.to_datetime(spotify_df['release_date'], errors='coerce').dt.year


top_artists = spotify_df['artist'].value_counts().head(5).index.tolist()
filtered_df = spotify_df[spotify_df['artist'].isin(top_artists)].dropna(subset=['release_year'])


sources = filtered_df['release_year'].astype(str).tolist()
targets = filtered_df['artist'].tolist()


all_labels = list(set(sources + targets))
label_map = {label: i for i, label in enumerate(all_labels)}
source_ids = [label_map[s] for s in sources]
target_ids = [label_map[t] for t in targets]


fig = go.Figure(data=[go.Sankey(
    node=dict(pad=15, thickness=20, line=dict(color="black", width=0.5), label=all_labels),
    link=dict(source=source_ids, target=target_ids, value=[1]*len(source_ids))
)])

fig.update_layout(title_text="Jahr → Künstler (Spotify)", font_size=10)
fig.show()









